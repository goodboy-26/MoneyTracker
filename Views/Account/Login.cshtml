@model MoneyTracker.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng nhập - MoneyTracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
            body {
                min-height: 100vh;
                background:
                    linear-gradient(
                        135deg,
                        #f3f7ff,
                        #edfdf7);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
            }

            .login-container {
                width: 100%;
                max-width: 1050px;
                background: white;
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 20px 60px rgba(0,0,0,.08);
            }

            .left-panel {
                min-height: 620px;
                padding: 60px;
                background:
                    linear-gradient(
                        135deg,
                        #2563eb,
                        #14b8a6);
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .left-panel h1 {
                font-weight: 700;
                font-size: 42px;
            }

            .brand-icon {
                width: 70px;
                height: 70px;
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255,255,255,.18);
                font-size: 30px;
                margin-bottom: 25px;
            }

            .login-form {
                padding: 65px;
            }

            .login-form h2 {
                font-weight: 700;
            }

            .form-control {
                min-height: 52px;
                border-radius: 12px;
            }

            .btn-login {
                min-height: 52px;
                border-radius: 12px;
                font-weight: 600;
                background:
                    linear-gradient(
                        135deg,
                        #2563eb,
                        #14b8a6);
                border: none;
            }

            .logo-text {
                font-weight: 700;
                font-size: 24px;
            }

            @@media(max-width: 768px) {
                .left-panel {
                    display: none;
                }

                .login-form {
                    padding: 35px;
                }
            }
    </style>
</head>

<body>

    <div class="container px-3">

        <div class="login-container mx-auto">

            <div class="row g-0">

                <div class="col-md-6 left-panel">

                    <div class="brand-icon">
                        <i class="fa-solid fa-wallet"></i>
                    </div>

                    <h1>MoneyTracker</h1>

                    <p class="fs-5 mt-3">
                        Kiểm soát tài chính.
                        <br />
                        Làm chủ tương lai.
                    </p>

                    <div class="mt-5">

                        <p>
                            <i class="fa-solid fa-circle-check me-2"></i>
                            Theo dõi thu nhập và chi tiêu
                        </p>

                        <p>
                            <i class="fa-solid fa-circle-check me-2"></i>
                            Quản lý ngân sách thông minh
                        </p>

                        <p>
                            <i class="fa-solid fa-circle-check me-2"></i>
                            Báo cáo và biểu đồ trực quan
                        </p>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="login-form">

                        <div class="logo-text text-primary mb-4">
                            <i class="fa-solid fa-chart-pie me-2"></i>
                            MoneyTracker
                        </div>

                        <h2>Chào mừng trở lại 👋</h2>

                        <p class="text-muted mb-4">
                            Đăng nhập để tiếp tục quản lý tài chính.
                        </p>


                        <form asp-action="Login"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <div class="mb-3">

                                <label class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="example@gmail.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="mb-3">

                                <label class="form-label">
                                    Mật khẩu
                                </label>

                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="••••••••" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="d-flex
                                justify-content-between
                                align-items-center
                                mb-4">

                                <div class="form-check">

                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                    </label>

                                </div>

                                <a asp-controller="Account"
                                   asp-action="ForgotPassword"
                                   class="text-decoration-none">
                                    Quên mật khẩu?
                                </a>

                            </div>


                            <button type="submit"
                                    class="btn btn-primary
                                btn-login
                                text-white
                                w-100">

                                Đăng nhập

                            </button>


                            <div class="text-center mt-4">

                                Chưa có tài khoản?

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="text-decoration-none fw-semibold">

                                    Đăng ký ngay

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>