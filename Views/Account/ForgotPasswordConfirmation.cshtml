@{
    ViewData["Title"] = "Khôi phục mật khẩu";
    Layout = null;

    var resetLink =
        TempData["ResetLink"] as string;
}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Khôi phục mật khẩu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>

<body class="bg-light">

    <div class="container">

        <div class="row
            justify-content-center
            align-items-center
            min-vh-100">

            <div class="col-lg-6">

                <div class="card
                    border-0
                    shadow-sm">

                    <div class="card-body p-5 text-center">

                        <div class="display-4 mb-3">
                            📩
                        </div>

                        <h3 class="fw-bold">
                            Kiểm tra email
                        </h3>

                        <p class="text-muted">

                            Nếu tài khoản tồn tại,
                            bạn sẽ nhận được hướng dẫn
                            đặt lại mật khẩu.

                        </p>


                        @if (!string.IsNullOrEmpty(resetLink))
                        {
                            <div class="alert
                                alert-warning
                                text-start">

                                <strong>
                                    Chế độ Development:
                                </strong>

                                <div class="mt-2">
                                    Hiện tại chưa cấu hình gửi email.
                                    Nhấn nút bên dưới để test chức năng.
                                </div>

                            </div>

                            <a href="@resetLink"
                               class="btn btn-primary">

                                Đặt lại mật khẩu

                            </a>
                        }


                        <div class="mt-4">

                            <a asp-action="Login"
                               class="text-decoration-none">

                                Quay lại đăng nhập

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>