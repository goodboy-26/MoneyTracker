@model IEnumerable<MoneyTracker.Models.Category>

@{
    ViewData["Title"] = "Danh mục hệ thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Danh mục hệ thống
        </h2>

        <p class="text-muted mb-0">
            Quản lý các danh mục mặc định cho toàn bộ người dùng.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="fa-solid fa-plus me-2"></i>
        Thêm danh mục

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="row g-4">

    <div class="col-lg-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h5 class="fw-bold text-success mb-3">
                    <i class="fa-solid fa-arrow-trend-up me-2"></i>
                    Thu nhập
                </h5>

                @foreach (var item in Model.Where(c => c.Type == "Income"))
                {
                    <div class="d-flex
                        justify-content-between
                        align-items-center
                        border-bottom
                        py-3">

                        <div>
                            <strong>@item.Name</strong>

                            <div class="small text-muted">
                                Danh mục hệ thống
                            </div>
                        </div>

                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fa-solid fa-pen"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">

                                <i class="fa-solid fa-trash"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h5 class="fw-bold text-danger mb-3">
                    <i class="fa-solid fa-arrow-trend-down me-2"></i>
                    Chi tiêu
                </h5>

                @foreach (var item in Model.Where(c => c.Type == "Expense"))
                {
                    <div class="d-flex
                        justify-content-between
                        align-items-center
                        border-bottom
                        py-3">

                        <div>
                            <strong>@item.Name</strong>

                            <div class="small text-muted">
                                Danh mục hệ thống
                            </div>
                        </div>

                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fa-solid fa-pen"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">

                                <i class="fa-solid fa-trash"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</div>