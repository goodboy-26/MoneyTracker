@model IEnumerable<MoneyTracker.Models.Transaction>

@{
    ViewData["Title"] = "Giao dịch";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}


<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

    <div>
        <h2 class="fw-bold mb-1">
            Giao dịch
        </h2>

        <p class="text-muted mb-0">
            Quản lý và tìm kiếm các khoản thu, chi của bạn.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="fa-solid fa-plus me-2"></i>
        Thêm giao dịch

    </a>

</div>


<!-- BỘ LỌC -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex align-items-center mb-3">

            <i class="fa-solid fa-filter text-primary me-2"></i>

            <h6 class="fw-bold mb-0">
                Bộ lọc giao dịch
            </h6>

        </div>


        <form method="get"
              asp-action="Index"
              class="row g-3">


            <!-- TÌM KIẾM -->
            <div class="col-xl-4 col-lg-6">

                <label class="form-label fw-semibold">
                    Tìm kiếm
                </label>

                <div class="input-group">

                    <span class="input-group-text bg-light">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Tên giao dịch hoặc ghi chú..." />

                </div>

            </div>


            <!-- LOẠI THU / CHI -->
            <div class="col-xl-2 col-lg-3 col-md-6">

                <label class="form-label fw-semibold">
                    Loại giao dịch
                </label>

                <select name="type"
                        id="typeFilter"
                        class="form-select">

                    <option value="">
                        Tất cả
                    </option>

                    @if (ViewBag.Type == "Income")
                    {
                        <option value="Income" selected>
                            Thu nhập
                        </option>
                    }
                    else
                    {
                        <option value="Income">
                            Thu nhập
                        </option>
                    }

                    @if (ViewBag.Type == "Expense")
                    {
                        <option value="Expense" selected>
                            Chi tiêu
                        </option>
                    }
                    else
                    {
                        <option value="Expense">
                            Chi tiêu
                        </option>
                    }

                </select>

            </div>


            <!-- DANH MỤC -->
            <div class="col-xl-3 col-lg-3 col-md-6">

                <label class="form-label fw-semibold">
                    Danh mục
                </label>

                <select name="categoryId"
                        id="categoryFilter"
                        class="form-select">

                    <option value="">
                        Tất cả danh mục
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        if (ViewBag.CategoryId != null &&
                            (int)ViewBag.CategoryId == category.Id)
                        {
                            <option value="@category.Id"
                                    data-type="@category.Type"
                                    selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id"
                                    data-type="@category.Type">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- TỪ NGÀY -->
            <div class="col-xl-3 col-lg-4 col-md-6">

                <label class="form-label fw-semibold">
                    Từ ngày
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>


            <!-- ĐẾN NGÀY -->
            <div class="col-xl-3 col-lg-4 col-md-6">

                <label class="form-label fw-semibold">
                    Đến ngày
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>


            <!-- ÁP DỤNG -->
            <div class="col-xl-3 col-lg-4 col-md-6 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fa-solid fa-filter me-2"></i>
                    Áp dụng bộ lọc

                </button>

            </div>


            <!-- XÓA LỌC -->
            <div class="col-xl-3 col-lg-4 col-md-6 d-flex align-items-end">

                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100">

                    <i class="fa-solid fa-rotate-left me-2"></i>
                    Xóa bộ lọc

                </a>

            </div>

        </form>

    </div>

</div>


<!-- SỐ KẾT QUẢ -->
<div class="d-flex justify-content-between align-items-center mb-2">

    <div class="text-muted small">

        <i class="fa-solid fa-list me-1"></i>

        Tìm thấy

        <strong class="text-dark">
            @Model.Count()
        </strong>

        giao dịch

    </div>

</div>


<!-- DANH SÁCH GIAO DỊCH -->
<div class="card border-0 shadow-sm">

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="fa-solid fa-magnifying-glass fs-1 text-secondary mb-3"></i>

                <h5>
                    Không tìm thấy giao dịch
                </h5>

                <p class="text-muted">
                    Không có giao dịch nào phù hợp với bộ lọc.
                </p>

                <a asp-action="Index"
                   class="btn btn-outline-primary me-2">

                    <i class="fa-solid fa-rotate-left me-1"></i>
                    Xóa bộ lọc

                </a>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="fa-solid fa-plus me-1"></i>
                    Thêm giao dịch

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Giao dịch
                            </th>

                            <th>
                                Danh mục
                            </th>

                            <th>
                                Thời gian
                            </th>

                            <th>
                                Loại
                            </th>

                            <th class="text-end">
                                Số tiền
                            </th>

                            <th class="text-end">
                                Thao tác
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- TÊN -->
                                <td>

                                    <strong>
                                        @item.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="small text-muted">
                                            @item.Note
                                        </div>
                                    }

                                </td>


                                <!-- DANH MỤC -->
                                <td>

                                    <span class="badge bg-secondary-subtle text-secondary">

                                        @item.Category?.Name

                                    </span>

                                </td>


                                <!-- NGÀY GIỜ -->
                                <td>

                                    <div>
                                        @item.TransactionDate.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="small text-muted">
                                        @item.TransactionDate.ToString("HH:mm")
                                    </div>

                                </td>


                                <!-- THU / CHI -->
                                <td>

                                    @if (item.Type == "Income")
                                    {
                                        <span class="badge bg-success-subtle text-success">

                                            <i class="fa-solid fa-arrow-down me-1"></i>

                                            Thu nhập

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">

                                            <i class="fa-solid fa-arrow-up me-1"></i>

                                            Chi tiêu

                                        </span>
                                    }

                                </td>


                                <!-- SỐ TIỀN -->
                                <td class="text-end fw-bold">

                                    @if (item.Type == "Income")
                                    {
                                        <span class="text-success">

                                            +@item.Amount.ToString("N0") ₫

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">

                                            -@item.Amount.ToString("N0") ₫

                                        </span>
                                    }

                                </td>


                                <!-- EDIT / DELETE -->
                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Chỉnh sửa">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Xóa">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const typeFilter =
                    document.getElementById("typeFilter");

                const categoryFilter =
                    document.getElementById("categoryFilter");


                // LƯU TOÀN BỘ DANH MỤC BAN ĐẦU
                const allCategories =
                    Array.from(
                        categoryFilter.querySelectorAll(
                            "option[data-type]"
                        )
                    );


                function filterCategories(resetCategory) {

                    const selectedType =
                        typeFilter.value;


                    allCategories.forEach(
                        function (option) {

                            if (
                                selectedType === "" ||
                                option.dataset.type === selectedType
                            ) {
                                option.hidden = false;
                                option.disabled = false;
                            }
                            else {
                                option.hidden = true;
                                option.disabled = true;
                            }

                        }
                    );


                    if (resetCategory) {

                        categoryFilter.value = "";

                    }

                }


                // LỌC NGAY KHI TRANG MỞ
                filterCategories(false);


                // KHI USER ĐỔI THU / CHI
                typeFilter.addEventListener(
                    "change",
                    function () {

                        filterCategories(true);

                    }
                );

            }
        );

    </script>
}