@model MoneyTracker.Models.Transaction

@{
    ViewData["Title"] = "Xóa giao dịch";
}

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card border-0 shadow-sm mt-4">

            <div class="card-body p-5 text-center">

                <div class="mb-3">
                    <i class="fa-solid fa-triangle-exclamation
                        text-danger
                        display-4">
                    </i>
                </div>

                <h3 class="fw-bold">
                    Xóa giao dịch?
                </h3>

                <p class="text-muted">
                    Bạn có chắc muốn xóa giao dịch này không?
                </p>

                <div class="bg-light rounded p-3 my-4 text-start">

                    <div class="mb-2">
                        <strong>Tên:</strong>
                        @Model.Title
                    </div>

                    <div class="mb-2">
                        <strong>Danh mục:</strong>
                        @Model.Category?.Name
                    </div>

                    <div class="mb-2">
                        <strong>Số tiền:</strong>
                        @Model.Amount.ToString("N0") ₫
                    </div>

                    <div>
                        <strong>Ngày:</strong>
                        @Model.TransactionDate.ToString("dd/MM/yyyy")
                    </div>

                </div>

                <form asp-action="DeleteConfirmed"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <a asp-action="Index"
                       class="btn btn-light px-4">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">
                        <i class="fa-solid fa-trash me-2"></i>
                        Xóa giao dịch
                    </button>

                </form>

            </div>

        </div>

    </div>
</div>