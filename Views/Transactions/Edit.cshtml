@model MoneyTracker.ViewModels.TransactionViewModel

@{
    ViewData["Title"] = "Sửa giao dịch";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">

        <div class="mb-4">
            <a asp-action="Index"
               class="text-decoration-none text-muted">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Quay lại danh sách
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">

                <h2 class="fw-bold mb-1">
                    Sửa giao dịch
                </h2>

                <p class="text-muted mb-4">
                    Cập nhật thông tin giao dịch của bạn.
                </p>

                <form asp-action="Edit"
                      method="post">

                    <input asp-for="Id"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Loại giao dịch
                        </label>

                        <div class="transaction-type-wrapper">

                            <input type="radio"
                                   asp-for="Type"
                                   value="Expense"
                                   id="typeExpense"
                                   class="btn-check" />

                            <label class="btn transaction-type-btn expense-btn"
                                   for="typeExpense">
                                <i class="fa-solid fa-arrow-down me-2"></i>
                                Chi tiêu
                            </label>

                            <input type="radio"
                                   asp-for="Type"
                                   value="Income"
                                   id="typeIncome"
                                   class="btn-check" />

                            <label class="btn transaction-type-btn income-btn"
                                   for="typeIncome">
                                <i class="fa-solid fa-arrow-up me-2"></i>
                                Thu nhập
                            </label>

                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Title"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group input-group-lg">
                            <input asp-for="Amount"
                                   class="form-control"
                                   min="1" />

                            <span class="input-group-text">
                                ₫
                            </span>
                        </div>

                        <span asp-validation-for="Amount"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="CategoryId"
                                    id="categorySelect"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Chọn danh mục --
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id"
                                            data-type="@category.Type">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="TransactionDate"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="TransactionDate"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="TransactionDate"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="mb-4">
                        <label asp-for="Note"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Note"
                                  class="form-control"
                                  rows="4">
                        </textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-light px-4">
                            Hủy
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Lưu thay đổi
                        </button>

                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const expenseRadio =
                document.getElementById("typeExpense");

            const incomeRadio =
                document.getElementById("typeIncome");

            const categorySelect =
                document.getElementById("categorySelect");

            function filterCategories() {

                const selectedType =
                    incomeRadio.checked
                        ? "Income"
                        : "Expense";

                const options =
                    categorySelect.querySelectorAll(
                        "option[data-type]"
                    );

                options.forEach(function(option) {

                    const categoryType =
                        option.getAttribute("data-type");

                    option.hidden =
                        categoryType !== selectedType;
                });
            }

            expenseRadio.addEventListener(
                "change",
                function() {
                    categorySelect.value = "";
                    filterCategories();
                });

            incomeRadio.addEventListener(
                "change",
                function() {
                    categorySelect.value = "";
                    filterCategories();
                });

            filterCategories();
        });
    </script>
}