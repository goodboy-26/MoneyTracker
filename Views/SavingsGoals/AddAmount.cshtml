@model MoneyTracker.ViewModels.AddSavingsAmountViewModel

@{
    ViewData["Title"] = "Thêm tiền";

    var percent =
        Model.TargetAmount > 0
            ? Math.Min(
                Model.CurrentAmount * 100 / Model.TargetAmount,
                100)
            : 0;

    var remaining =
        Math.Max(
            Model.TargetAmount - Model.CurrentAmount,
            0);

    var availableForSavings =
        (decimal)(ViewBag.AvailableForSavings ?? 0m);
}

<div class="row justify-content-center">

    <div class="col-lg-7 col-xl-6">

        <div class="mb-4">

            <a asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="fa-solid fa-arrow-left me-2"></i>
                Quay lại mục tiêu

            </a>

            <h2 class="fw-bold mt-3 mb-1">
                Thêm tiền tiết kiệm
            </h2>

            <p class="text-muted">
                @Model.GoalName
            </p>

        </div>


        <div class="dashboard-card">

            <!-- TIẾN ĐỘ MỤC TIÊU -->

            <div class="mb-4">

                <div class="d-flex justify-content-between mb-2">

                    <span class="text-muted">
                        Tiến độ hiện tại
                    </span>

                    <strong>
                        @percent.ToString("0.#")%
                    </strong>

                </div>

                <div class="progress mb-3"
                     style="height: 10px;">

                    <div class="progress-bar"
                         style="width: @percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>

                </div>

                <div class="d-flex justify-content-between">

                    <div>

                        <small class="text-muted d-block">
                            Đã tiết kiệm
                        </small>

                        <strong>
                            @Model.CurrentAmount.ToString("N0") ₫
                        </strong>

                    </div>

                    <div class="text-end">

                        <small class="text-muted d-block">
                            Còn thiếu
                        </small>

                        <strong>
                            @remaining.ToString("N0") ₫
                        </strong>

                    </div>

                </div>

            </div>


            <!-- SỐ TIỀN CÓ THỂ ĐƯA VÀO SAVINGS -->

            <div class="alert alert-info border-0 mb-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="small mb-1">
                            Có thể đưa vào tiết kiệm tháng này
                        </div>

                        <div class="fw-bold fs-4">
                            @availableForSavings.ToString("N0") ₫
                        </div>

                        <div class="small mt-1">
                            Sau khi trừ chi tiêu thực tế và tiền đã tiết kiệm trong tháng.
                        </div>

                    </div>

                    <div class="ms-3">

                        <i class="fa-solid fa-wallet fa-2x"></i>

                    </div>

                </div>

            </div>


            <!-- FORM THÊM TIỀN -->

            <form asp-action="AddAmount"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-4">

                    <label asp-for="Amount"
                           class="form-label fw-semibold">
                    </label>

                    <div class="input-group input-group-lg">

                        <input asp-for="Amount"
                               type="number"
                               min="1"
                               step="1000"
                               max="@availableForSavings.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control"
                               placeholder="Nhập số tiền" />

                        <span class="input-group-text">
                            ₫
                        </span>

                    </div>

                    <span asp-validation-for="Amount"
                          class="text-danger small">
                    </span>


                    @if (availableForSavings <= 0)
                    {
                        <div class="text-danger small mt-2">

                            <i class="fa-solid fa-circle-exclamation me-1"></i>

                            Hiện không còn tiền khả dụng để đưa vào tiết kiệm.

                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mt-2">

                            Tối đa:
                            <strong>
                                @availableForSavings.ToString("N0") ₫
                            </strong>

                        </div>
                    }

                </div>


                @if (availableForSavings > 0 && remaining > 0)
                {
                    <button type="submit"
                            class="btn btn-primary w-100 py-2">

                        <i class="fa-solid fa-piggy-bank me-2"></i>
                        Thêm vào mục tiêu

                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary w-100 py-2"
                            disabled>

                        <i class="fa-solid fa-ban me-2"></i>

                        @if (remaining <= 0)
                        {
                            <span>
                                Mục tiêu đã hoàn thành
                            </span>
                        }
                        else
                        {
                            <span>
                                Không còn tiền để tiết kiệm
                            </span>
                        }

                    </button>
                }

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}