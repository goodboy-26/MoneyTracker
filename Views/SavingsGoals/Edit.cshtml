@model MoneyTracker.ViewModels.SavingsGoalViewModel

@{
    ViewData["Title"] = "Sửa mục tiêu";
}

<div class="row justify-content-center">

    <div class="col-lg-7 col-xl-6">

        <div class="mb-4">

            <a asp-action="Index"
               class="text-decoration-none text-muted">

                <i class="fa-solid fa-arrow-left me-2"></i>
                Quay lại mục tiêu

            </a>

            <h2 class="fw-bold mt-3 mb-1">
                Chỉnh sửa mục tiêu
            </h2>

            <p class="text-muted">
                Cập nhật thông tin mục tiêu tiết kiệm.
            </p>

        </div>


        <div class="dashboard-card">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger small">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="TargetAmount"
                           class="form-label fw-semibold">
                    </label>

                    <div class="input-group">

                        <input asp-for="TargetAmount"
                               type="number"
                               min="1"
                               step="1000"
                               class="form-control" />

                        <span class="input-group-text">
                            ₫
                        </span>

                    </div>

                    <span asp-validation-for="TargetAmount"
                          class="text-danger small">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="TargetDate"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TargetDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="TargetDate"
                          class="text-danger small">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Lưu thay đổi

                    </button>

                    <a asp-action="Index"
                       class="btn btn-light">
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}