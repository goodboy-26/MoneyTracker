@model MoneyTracker.ViewModels.SavingsGoalViewModel

@{
    ViewData["Title"] = "Tạo mục tiêu tiết kiệm";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Tạo mục tiêu tiết kiệm
            </h2>

            <p class="text-muted mb-0">
                Đặt mục tiêu và bắt đầu kế hoạch tiết kiệm của bạn.
            </p>
        </div>

        <a asp-controller="SavingsGoals"
           asp-action="Index"
           class="btn btn-light">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Quay lại
        </a>
    </div>


    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="goal-icon">
                            <i class="fa-solid fa-piggy-bank"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Thông tin mục tiêu
                            </h5>

                            <div class="text-muted small">
                                Nhập số tiền và thời hạn bạn muốn đạt được.
                            </div>
                        </div>

                    </div>


                    <form asp-controller="SavingsGoals"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Tên mục tiêu
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Ví dụ: Mua laptop, Du lịch..." />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="TargetAmount"
                                   class="form-label fw-semibold">
                                Số tiền mục tiêu
                            </label>

                            <div class="input-group">

                                <input asp-for="TargetAmount"
                                       type="number"
                                       min="1"
                                       step="1000"
                                       class="form-control"
                                       placeholder="10000000" />

                                <span class="input-group-text">
                                    ₫
                                </span>

                            </div>

                            <span asp-validation-for="TargetAmount"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="TargetDate"
                                   class="form-label fw-semibold">
                                Hạn hoàn thành
                            </label>

                            <input asp-for="TargetDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="TargetDate"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                                Mô tả
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ghi chú thêm về mục tiêu..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="SavingsGoals"
                               asp-action="Index"
                               class="btn btn-light">
                                Hủy
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa-solid fa-plus me-2"></i>
                                Tạo mục tiêu

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    .goal-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 14px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .form-control,
    .input-group-text {
        min-height: 46px;
        border-color: #e2e8f0;
    }

    .form-control:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .1);
    }
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}