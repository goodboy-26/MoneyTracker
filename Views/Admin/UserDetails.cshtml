@model MoneyTracker.Models.AppUser

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-4">

                    <div>

                        <h3 class="fw-bold mb-1">
                            @Model.FullName
                        </h3>

                        <p class="text-muted mb-0">
                            @Model.Email
                        </p>

                    </div>

                    <span class="badge bg-dark fs-6">
                        @ViewBag.Role
                    </span>

                </div>


                <hr />


                <div class="row g-4 mb-4">

                    <div class="col-md-6">

                        <div class="text-muted small">
                            Số điện thoại
                        </div>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                ? "Chưa cập nhật"
                                : Model.PhoneNumber)
                        </strong>

                    </div>


                    <div class="col-md-6">

                        <div class="text-muted small">
                            Ngày tạo tài khoản
                        </div>

                        <strong>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>

                    </div>

                </div>


                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="card bg-light border-0">

                            <div class="card-body text-center">

                                <div class="text-muted">
                                    Giao dịch
                                </div>

                                <h3 class="fw-bold">
                                    @ViewBag.TransactionCount
                                </h3>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="card bg-light border-0">

                            <div class="card-body text-center">

                                <div class="text-muted">
                                    Ngân sách
                                </div>

                                <h3 class="fw-bold">
                                    @ViewBag.SpendingPlanCount
                                </h3>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="card bg-light border-0">

                            <div class="card-body text-center">

                                <div class="text-muted">
                                    Danh mục riêng
                                </div>

                                <h3 class="fw-bold">
                                    @ViewBag.CategoryCount
                                </h3>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="mt-4">

                    <a asp-action="Users"
                       class="btn btn-light">

                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Quay lại

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>