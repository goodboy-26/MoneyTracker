@model IEnumerable<MoneyTracker.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="d-flex
    justify-content-between
    align-items-center
    mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Quản lý người dùng
        </h2>

        <p class="text-muted mb-0">
            Quản lý tài khoản trong hệ thống.
        </p>
    </div>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-2">

            <div class="col-md-10">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Tìm theo tên hoặc email..." />

            </div>

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-dark w-100">

                    <i class="fa-solid fa-magnifying-glass me-1"></i>
                    Tìm

                </button>

            </div>

        </form>

    </div>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Người dùng</th>
                        <th>Vai trò</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end">
                            Thao tác
                        </th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @item.FullName
                                </strong>

                                <div class="small text-muted">
                                    @item.Email
                                </div>

                            </td>


                            <td>

                                @if (item.Role == "Admin")
                                {
                                    <span class="badge bg-dark">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                        bg-primary-subtle
                                        text-primary">
                                        User
                                    </span>
                                }

                            </td>


                            <td>
                                @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>


                            <td>

                                @if (item.IsLocked)
                                {
                                    <span class="badge
                                        bg-danger-subtle
                                        text-danger">

                                        Đã khóa

                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                        bg-success-subtle
                                        text-success">

                                        Hoạt động

                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-action="UserDetails"
                                   asp-route-id="@item.Id"
                                   class="btn
                                    btn-sm
                                    btn-outline-primary">

                                    <i class="fa-solid fa-eye"></i>

                                </a>


                                @if (item.Role != "Admin")
                                {
                                    <form asp-action="ToggleLock"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        @if (item.IsLocked)
                                        {
                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-success">

                                                <i class="fa-solid fa-lock-open"></i>

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-danger">

                                                <i class="fa-solid fa-lock"></i>

                                            </button>
                                        }

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>